# Canonical host: elevatedthinking.co (no www).
#
# This file must live in public/ so it ships inside every build. The production
# deploy mirrors dist/ over the web root and prunes anything the release does
# not contain, so a copy placed by hand in hPanel would be deleted by the next
# release.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send www.<host> to <host>, preserving the path and query string.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
